{
  "name": "homeassistant-mcp",
  "version": "0.1.0",
  "description": "Enhanced Model Context Protocol Server for Home Assistant - Enterprise-grade smart home automation platform with 7 advanced tools",
  "type": "module",
  "main": "dist/src/mcp-server.js",
  "keywords": [
    "home-assistant",
    "mcp",
    "model-context-protocol",
    "smart-home",
    "automation",
    "energy-management",
    "weather-integration",
    "network-monitoring",
    "backup-management",
    "error-recovery",
    "system-health",
    "ai-nlp",
    "iot",
    "typescript"
  ],
  "scripts": {
    "build": "npx tsc",
    "start": "node dist/src/index.js",
    "mcp": "node dist/src/mcp-server.js",
    "dev": "tsx watch src/index.ts",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --config=jest.config.cjs",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --config=jest.config.cjs --coverage",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --config=jest.config.cjs --watch",
    "test:integration": "NODE_OPTIONS=--experimental-vm-modules jest --config=jest.config.cjs --testNamePattern='integration'",
    "test:e2e": "NODE_OPTIONS=--experimental-vm-modules jest --config=jest.config.cjs --testNamePattern='e2e'",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "prepare": "npm run build",
    "clean": "rimraf dist",
    "docs:generate": "node dist/src/api-docs/generate-docs.js",
    "docs:serve": "node dist/src/api-docs/swagger.js",
    "health:check": "node dist/src/tools/system-health.js",
    "backup:status": "node dist/src/backup/status.js",
    "types:check": "tsc --noEmit",
    "types:install": "npm install --save-dev @types/node @types/jest"
  },
  "dependencies": {
    "@digital-alchemy/core": "^24.11.4",
    "@digital-alchemy/hass": "^24.11.4",
    "ajv": "^8.12.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "litemcp": "^0.7.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "uuid": "^9.0.1",
    "ws": "^8.16.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/ajv": "^1.0.0",
    "@types/express": "^4.17.21",
    "@types/express-rate-limit": "^6.0.0",
    "@types/helmet": "^4.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.16",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.6",
    "@types/uuid": "^9.0.8",
    "@types/ws": "^8.5.10",
    "jest": "^29.7.0",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.1.2",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "author": "Jango Blockchained",
  "license": "MIT",
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
